# Copy this file to .env and fill it in.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# The PostgreSQL container from docker-compose.yml (host port 5434).
# The tests use a separate test_muni database that pytest-django creates itself.
DATABASE_URL=postgres://muni:muni@localhost:5434/muni
