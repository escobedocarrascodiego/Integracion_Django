# Copy this file to .env and fill it in.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Claude API key for the chat, from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: defaults to claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5
# Only if your API key is not scoped to a single workspace (ID column of
# https://platform.claude.com/settings/workspaces)
# ANTHROPIC_WORKSPACE_ID=

# The PostgreSQL container from docker-compose.yml (host port 5434).
# The tests use a separate test_muni database that pytest-django creates itself.
DATABASE_URL=postgres://muni:muni@localhost:5434/muni
